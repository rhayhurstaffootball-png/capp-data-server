[Unit]
Description=CAPP VNC Relay
After=network.target

[Service]
ExecStart=/usr/local/bin/uvicorn capp_relay:app --host 0.0.0.0 --port 443 --ssl-keyfile /etc/letsencrypt/live/relay.cappvcs.com/privkey.pem --ssl-certfile /etc/letsencrypt/live/relay.cappvcs.com/fullchain.pem --ws-ping-interval 3600
WorkingDirectory=/opt
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
